{
  "name": "blog",
  "version": "1.0.0",
  "description": "개인 블로그",
  "type": "commonjs",
  "main": "build/build.js",
  "scripts": {
    "build": "node build/build.js",
    "build:full": "node build/build.js --full",
    "dev": "npm run build && npx http-server public -p 8080 -o",
    "dev:full": "npm run build:full && npx http-server public -p 8080 -o",
    "serve": "npx http-server public -p 8080 -o",
    "clean": "rm -rf public/* .build-cache.json",
    "push": "git push origin main && node build/push.js",
    "pull": "node build/pull.js",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "blog",
    "markdown",
    "static-site"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fs-extra": "^11.1.1",
    "gray-matter": "^4.0.3",
    "marked": "^11.0.0"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
