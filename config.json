{
  "github": {
    "owner": "your-username",
    "repo": "blog",
    "branch": "main"
  },
  "_comment": "GitHub Personal Access Token은 localStorage에 저장하세요: localStorage.setItem('github_token', 'ghp_xxx')",
  "blog": {
    "title": "내 블로그",
